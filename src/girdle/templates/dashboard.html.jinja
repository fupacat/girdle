<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>girdle report — {{ data.repo_root }}</title>
<style>
  :root {
    --bg: #0f1115; --panel: #171a21; --border: #2a2f3a;
    --text: #e6e8eb; --muted: #8a919e;
    --neutral: #7f8794; --bronze: #cd7f32; --silver: #aeb5c0; --gold: #d4af37; --red: #e05252;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2.5rem; background: var(--bg); color: var(--text);
    font-family: -apple-system, "Segoe UI", Inter, sans-serif;
  }
  h1 { font-size: 1.4rem; font-weight: 600; margin: 0 0 0.25rem; }
  h2 { font-size: 1.05rem; margin: 0 0 0.9rem; }
  .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 2rem; }
  .summary-row { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .summary-card {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 1rem 1.4rem; min-width: 170px;
  }
  .summary-card .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .summary-card .value { font-size: 1.6rem; font-weight: 600; margin-top: 0.2rem; }
  .summary-card.state-neutral .value { color: var(--neutral); }
  .summary-card.state-bronze .value { color: var(--bronze); }
  .summary-card.state-silver .value { color: var(--silver); }
  .summary-card.state-gold .value { color: var(--gold); }
  .summary-card.state-red .value { color: var(--red); }

  .section {
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 1.2rem 1.4rem; margin-bottom: 1.2rem;
  }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.7rem; }
  .cat {
    border: 1px solid var(--border); border-radius: 8px; padding: 0.7rem 0.9rem;
    border-left-width: 4px;
  }
  .cat.state-neutral { border-left-color: var(--neutral); }
  .cat.state-bronze { border-left-color: var(--bronze); }
  .cat.state-silver { border-left-color: var(--silver); }
  .cat.state-gold { border-left-color: var(--gold); }
  .cat.state-red { border-left-color: var(--red); }
  .cat-name { font-weight: 600; font-size: 0.85rem; text-transform: capitalize; }
  .cat-score { font-size: 1.1rem; margin-top: 0.25rem; }
  .cat-state { font-size: 0.8rem; color: var(--muted); }
  .cat-meta { font-size: 0.75rem; color: var(--muted); margin-top: 0.2rem; }
  .cat-outstanding { font-size: 0.75rem; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed var(--border); }
  .cat-outstanding ul { margin: 0.3rem 0 0 1.2rem; padding: 0; }
  .cat-outstanding li { margin: 0.2rem 0; }

  .list { margin: 0; padding-left: 1.2rem; color: var(--muted); }
  .warnings { color: var(--gold); font-size: 0.85rem; margin-top: 1.5rem; }
</style>
</head>
<body>
  <h1>girdle report</h1>
  <div class="meta">{{ data.repo_root }} &middot; mode={{ data.mode }} &middot; scanned {{ data.scanned_at }} &middot; girdle {{ data.girdle_version }}</div>

  <div class="summary-row">
    <div class="summary-card">
      <div class="label">Ecosystems</div>
      <div class="value">{{ data.summary.ecosystem_count }}</div>
    </div>
    <div class="summary-card {{ data.summary.overall_state | state_class }}">
      <div class="label">Overall score</div>
      <div class="value">{{ data.summary.overall_percentage }}%</div>
      <div class="cat-state">{{ data.summary.overall_state | state_label }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Outstanding checks</div>
      <div class="value">{{ data.summary.overall_outstanding | length }}</div>
    </div>
  </div>

  <div class="section">
    <h2>category scores</h2>
    <div class="cat-grid">
      {% for name, score in data.summary.category_scores.items() %}
      <div class="cat {{ score.state | state_class }}">
        <div class="cat-name">{{ name.replace('_', ' ') }}</div>
        <div class="cat-score">{{ score.percentage }}%</div>
        <div class="cat-state">{{ score.state | state_label }}</div>
        <div class="cat-meta">{{ score.passed }}/{{ score.total }} checks passed</div>
        {% if score.outstanding %}
        <div class="cat-outstanding">
          Outstanding items:
          <ul>
            {% for check in score.outstanding %}
            <li>{{ check.replace('_', ' ') }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="section">
    <h2>detected ecosystems</h2>
    <ul class="list">
      {% for eco in data.ecosystems %}
      <li>
        {{ eco.language }}/{{ eco.toolchain }} ({{ eco.id }}, root={{ eco.root }}){% if eco.variants %} — {{ eco.variants | join(', ') }}{% endif %}
        <ul>
          {% for name, category in eco.categories.items() %}
          <li>
            {{ name.replace('_', ' ') }}: {{ category['status'] }} (tier {{ category['tier'] }})
            {% if category.evidence %}
            <div class="cat-meta">Evidence: {{ category.evidence | join(', ') }}</div>
            {% endif %}
            {% if category.recommendation %}
            <div class="cat-outstanding">Recommendation: {{ category.recommendation }}</div>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </li>
      {% endfor %}
    </ul>
  </div>

  {% if data.platform %}
  <div class="section">
    <h2>platform</h2>
    {% if not data.platform.available %}
      <div class="cat-state">not checked: {{ data.platform.reason }}</div>
    {% elif not data.platform.protected %}
      <div class="cat-state">{{ data.platform.repo }}@{{ data.platform.default_branch }} — no branch protection</div>
    {% else %}
      <div class="cat-state">{{ data.platform.repo }}@{{ data.platform.default_branch }} — protected</div>
      <div class="cat-meta">required reviews: {{ data.platform.required_approving_review_count }} &middot; require code owners: {{ data.platform.require_code_owner_reviews }}</div>
      <div class="cat-meta">enforce for admins: {{ data.platform.enforce_admins }} &middot; allow force pushes: {{ data.platform.allow_force_pushes }}</div>
      <div class="cat-meta">require signed commits: {{ data.platform.required_signatures }}</div>
      <div class="cat-meta">required status checks: {{ data.platform.required_status_check_contexts | join(', ') if data.platform.required_status_check_contexts else '(none named)' }}</div>
    {% endif %}
    {% for rec in data.platform.recommendations %}
    <div class="cat-outstanding">{{ rec }}</div>
    {% endfor %}
  </div>
  {% endif %}

  {% if data.warnings %}
  <div class="warnings">
    {% for w in data.warnings %}&#9888; {{ w }}<br>{% endfor %}
  </div>
  {% endif %}
</body>
</html>
